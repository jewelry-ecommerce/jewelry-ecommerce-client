# Java integration configuration. Merge into .env.local, do not overwrite other local settings.
# Checkout orchestration and several admin modules are not yet fully integrated.
NEXT_PUBLIC_BACKEND_PROVIDER=JAVA
API_BE_URL=http://localhost:8082
API_BE_PREFIX=/api/v1
NEXT_PUBLIC_CONTENT_API_URL=http://localhost:8082
NEXT_PUBLIC_CONTENT_API_PREFIX=/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3100
AUTH_COOKIE_SECURE=false
